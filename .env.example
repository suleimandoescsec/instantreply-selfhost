# --- Meta (WhatsApp Cloud API) ---
# Graph API version. v26.0 was the current stable version on 2026-10-04
# (https://developers.facebook.com/docs/graph-api/changelog/versions). Check before you deploy.
GRAPH_API_VERSION=v26.0
# App Dashboard > App settings > Basic > App secret. Used to verify X-Hub-Signature-256.
APP_SECRET=
# Any random string you choose; paste the same value into the webhook setup in the Meta dashboard.
VERIFY_TOKEN=
# System User access token (whatsapp_business_messaging + whatsapp_business_management).
ACCESS_TOKEN=
# WhatsApp > API Setup > "Phone number ID" (NOT the phone number itself).
PHONE_NUMBER_ID=

# --- AI (any OpenAI-compatible /chat/completions endpoint; bring your own key) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Model name as your provider spells it.
AI_MODEL=

# --- Optional ---
PORT=3000
BUSINESS_FILE=./business.md
DB_PATH=./data/bot.db
HISTORY_MESSAGES=10
MAX_REPLY_CHARS=600
RATE_LIMIT_PER_MIN=6
MAX_BODY_BYTES=3145728
HISTORY_RETENTION_DAYS=30
# Comma-separated extra words/phrases that hand a chat to a human (added to the built-in list).
HANDOFF_KEYWORDS=

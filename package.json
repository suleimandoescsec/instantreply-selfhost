{
  "name": "instantreply-selfhost",
  "version": "0.1.0",
  "description": "Bare-bones self-hosted WhatsApp Cloud API AI auto-reply starter (bring your own Meta app and AI key).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20.6" },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/src/index.js",
    "dev": "npm run build && npm start",
    "test": "tsc && node --test dist/test/server.test.js dist/test/bot.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
